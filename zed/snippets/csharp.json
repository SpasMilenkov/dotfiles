{
  "Class (basic)": {
    "prefix": "class",
    "body": [
      "using System;",
      "",
      "namespace ${1:MyNamespace};",
      "    public class ${2:ClassName}",
      "    {",
      "        public ${2:ClassName}()",
      "        {",
      "            $0",
      "        }",
      "    }"
    ],
    "description": "Basic public class with constructor"
  },

  "Interface": {
